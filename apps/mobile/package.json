    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.18.0",
    "expo": "~57.0.21",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
