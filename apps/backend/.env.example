# Локальный запуск backend.

# Приложение
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Swagger для локальной разработки
SWAGGER_ENABLED=true
SWAGGER_BASIC_AUTH_ENABLED=false
SWAGGER_BASIC_AUTH_USER=
SWAGGER_BASIC_AUTH_PASSWORD=

# PostgreSQL из локального docker-compose.yml
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=patrol
DATABASE_PASSWORD=patrol
DATABASE_NAME=patrol
DATABASE_SSL=false

# Redis из локального docker-compose.yml
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Только локальные секреты. В production используются другие случайные значения.
JWT_ACCESS_SECRET=dev_only_access_secret_64_chars_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_REFRESH_SECRET=dev_only_refresh_secret_64_chars_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=604800

# Первый администратор. Нужны только при запуске bootstrap-команды.
BOOTSTRAP_ADMIN_USERNAME=system.admin
BOOTSTRAP_ADMIN_FULL_NAME=Local Administrator
BOOTSTRAP_ADMIN_ACCESS_KEY=

# Server push через Expo
PUSH_NOTIFICATIONS_ENABLED=false
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=

# Локальное хранение загруженных файлов
FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_ROOT=./storage
FILE_UPLOAD_MAX_SIZE_MB=10
FILE_IMAGE_MAX_WIDTH=1600
FILE_IMAGE_QUALITY=80

# Внешнее ядро отчётности пока отключено
REPORTING_CORE_PUBLISH_ENABLED=false
REPORTING_CORE_TRANSPORT=disabled
REPORTING_CORE_URL=
REPORTING_CORE_API_KEY=
REPORTING_OUTBOX_BATCH_SIZE=50
REPORTING_OUTBOX_PUBLISH_INTERVAL_MS=30000
