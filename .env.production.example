# Приложение и локальный порт Nginx gateway
NODE_ENV=production
PORT=3000
WEB_PORT=8080
API_PREFIX=api/v1
CORS_ORIGINS=https://patrol.example.ru

# Swagger в production выключен. При включении Basic Auth обязателен.
SWAGGER_ENABLED=false
SWAGGER_BASIC_AUTH_ENABLED=false
SWAGGER_BASIC_AUTH_USER=
SWAGGER_BASIC_AUTH_PASSWORD=

# PostgreSQL внутри Docker-сети
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=patrol
DATABASE_PASSWORD=
DATABASE_NAME=patrol
DATABASE_SSL=false

# Redis внутри Docker-сети
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Укажите разные случайные значения длиной не менее 64 символов.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=604800

# Временные данные для создания первого администратора
BOOTSTRAP_ADMIN_USERNAME=system.admin
BOOTSTRAP_ADMIN_FULL_NAME=Главный администратор
BOOTSTRAP_ADMIN_ACCESS_KEY=

# Server push через Expo
PUSH_NOTIFICATIONS_ENABLED=false
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=

# Постоянный Docker volume с загруженными файлами
FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_ROOT=/app/storage
FILE_UPLOAD_MAX_SIZE_MB=10
FILE_IMAGE_MAX_WIDTH=1600
FILE_IMAGE_QUALITY=80

# Интеграция с внешним ядром отчётности пока отключена
REPORTING_CORE_PUBLISH_ENABLED=false
REPORTING_CORE_TRANSPORT=disabled
REPORTING_CORE_URL=
REPORTING_CORE_API_KEY=
REPORTING_OUTBOX_BATCH_SIZE=50
REPORTING_OUTBOX_PUBLISH_INTERVAL_MS=30000
