NODE_ENV=production
PORT=3000
WEB_PORT=8080
API_PREFIX=api/v1
SWAGGER_ENABLED=false
SWAGGER_BASIC_AUTH_ENABLED=false
SWAGGER_BASIC_AUTH_USER=
SWAGGER_BASIC_AUTH_PASSWORD=

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=patrol
DATABASE_PASSWORD=change_me_strong_database_password
DATABASE_NAME=patrol
DATABASE_SSL=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_strong_redis_password

JWT_ACCESS_SECRET=change_me_generate_64_plus_chars_with_openssl_rand_base64_64
JWT_REFRESH_SECRET=change_me_generate_another_64_plus_chars_with_openssl_rand_base64_64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=604800

PUSH_NOTIFICATIONS_ENABLED=false
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=

FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_ROOT=/app/storage
FILE_UPLOAD_MAX_SIZE_MB=10
FILE_IMAGE_MAX_WIDTH=1600
FILE_IMAGE_QUALITY=80

REPORTING_CORE_PUBLISH_ENABLED=false
REPORTING_CORE_TRANSPORT=disabled
REPORTING_CORE_URL=
REPORTING_CORE_API_KEY=
REPORTING_OUTBOX_BATCH_SIZE=50
REPORTING_OUTBOX_PUBLISH_INTERVAL_MS=30000

CORS_ORIGINS=https://patrol.example.ru
